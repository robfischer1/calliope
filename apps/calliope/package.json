{
  "name": "@forge/calliope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "calliope-mcp": "./src/mcp/main.ts",
    "calliope-mcp-http": "./src/mcp/http.ts"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "bun run --watch src/mcp/http.ts",
    "build": "bun build src/mcp/http.ts --target=bun --outfile dist/server.js",
    "build:sidecar": "bun build --compile --target=bun-windows-x64 src/mcp/sidecar.ts --outfile dist/calliope-sidecar.exe && bun build --compile --target=bun-linux-x64 src/mcp/sidecar.ts --outfile dist/calliope-sidecar && bun run scripts/copy-search-assets.ts",
    "fetch-search-assets": "bun run scripts/fetch-search-assets.ts",
    "start": "bun run src/mcp/main.ts",
    "start:http": "bun run src/mcp/http.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@forge/stellar-core-ts": "0.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "kafkajs": "^2.2.4",
    "onnxruntime-web": "^1.27.0",
    "pg": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10",
    "@stryker-mutator/vitest-runner": "10",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "eslint": "^10.0.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  }
}

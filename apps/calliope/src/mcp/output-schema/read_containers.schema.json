{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.notusmi.com/schema/tool-output/calliope_read_containers/v1",
  "title": "calliope_read_containers \u2014 the answer",
  "description": "Each requested container (once) with its revision, frontmatter and ordered blocks; a block whose prose is absent, or whose text was not asked for, has null text (dangling is only a fact of the graph). missing lists ids with no tree and no frontmatter. A refusal is NOT described here: it is an isError result {code, detail} (refusal.schema.json), and its code is in contracts/refusal-codes.toml.",
  "type": "object",
  "properties": {
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "container": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "frontmatter": {
            "type": [
              "string",
              "null"
            ]
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slot": {
                  "type": "string"
                },
                "position": {
                  "type": "string"
                },
                "blobId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "dangling": {
                  "type": "boolean"
                },
                "facts": {
                  "type": "array",
                  "description": "The slot's facts (only on a facts read); form says whether each is a node token or a literal placeholder.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "predicate": {
                        "type": "string"
                      },
                      "form": {
                        "type": "string",
                        "enum": [
                          "node",
                          "literal"
                        ]
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "predicate",
                      "form",
                      "value"
                    ]
                  }
                },
                "ref": {
                  "type": "object",
                  "description": "Present only on a placement (a slot that places another slot): the origin slot it resolves through and the container holding that origin. blobId is the origin's; an orphaned placement keeps its ref and reads dangling. Absent on every blob slot.",
                  "properties": {
                    "slot": {
                      "type": "string"
                    },
                    "container": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "slot"
                  ]
                }
              },
              "required": [
                "slot",
                "position",
                "blobId",
                "text",
                "dangling"
              ]
            }
          }
        },
        "required": [
          "container",
          "revision",
          "frontmatter",
          "blocks"
        ]
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "containers",
    "missing"
  ]
}

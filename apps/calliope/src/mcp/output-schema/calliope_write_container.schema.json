{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.notusmi.com/schema/tool-output/calliope_write_container/v1",
  "title": "calliope_write_container \u2014 the answer",
  "description": "One container save. noop says nothing was written. An ops save also answers applied, minted and blobIds; a replacements save answers container, counts and slots_changed; a notes-tenant save adds the inline-tag outcome (tags, or tags_error when the reconcile failed). A refusal is NOT described here: it is an isError result {code, detail} (refusal.schema.json), and its code is in contracts/refusal-codes.toml.",
  "type": "object",
  "properties": {
    "noop": {
      "type": "boolean"
    },
    "tx": {
      "type": "integer"
    },
    "applied": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "minted": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "blobIds": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "container": {
      "type": "string"
    },
    "counts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "expected": {
            "type": "integer",
            "minimum": 0
          },
          "found": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "expected",
          "found"
        ]
      }
    },
    "slots_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "added",
        "removed"
      ]
    },
    "tags_error": {
      "type": "string"
    }
  },
  "required": [
    "noop"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.notusmi.com/schema/tool-output/calliope_blob_census/v1",
  "title": "calliope_blob_census \u2014 the answer",
  "description": "The blob census report: whether every rostered tenant graph reported, how many blob ids the logs hold, and the ids newly marked, reaped or dangling. A refusal is NOT described here: it is an isError result {error, detail}, which calliope has not yet moved to the fleet's {code, detail} refusal.schema.json.",
  "type": "object",
  "properties": {
    "complete": {
      "type": "boolean"
    },
    "reporters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "graph": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "graph",
          "ok",
          "count"
        ]
      }
    },
    "held": {
      "type": "integer",
      "minimum": 0
    },
    "dangling": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "marked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reaped": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "executed": {
      "type": "boolean"
    }
  },
  "required": [
    "complete",
    "reporters",
    "held",
    "dangling",
    "marked",
    "reaped",
    "executed"
  ]
}
